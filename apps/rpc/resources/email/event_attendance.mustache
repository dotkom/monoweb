{{> event-image }}
<tr>
  <td class="text-primary" style="color: #000000; font-size: 16px; line-height: 25px; overflow-wrap: anywhere; word-wrap: break-word;">
    <p style="margin: 0 0 16px;">Hei!</p>
    <p style="margin: 0;">Du er påmeldt {{ eventName }}. Vi gleder oss til å se deg!</p>
  </td>
</tr>
<tr>
  <td style="padding: 24px 0 0;">
    <table border="0" cellpadding="0" cellspacing="0" role="presentation">
      <tbody>
        <tr>
          {{# buttons.event }}
          {{> primary-button }}
          {{/ buttons.event }}
        </tr>
      </tbody>
    </table>
  </td>
</tr>
<tr>
  <td class="text-secondary" style="padding: 24px 0 0; color: #4b5563; font-size: 14px; line-height: 22px;">
    <p style="margin: 0 0 12px;">Du kan melde deg av frem til {{ deregistrationDeadline }} på arrangementssiden.</p>
    <p class="text-secondary" style="margin: 0; color: #4b5563; font-size: 14px; line-height: 22px;">Mangel på oppmøte uten avmelding resulterer i prikk og/eller suspensjon. Les mer om <a class="text-secondary" href="https://wiki.online.ntnu.no/online-info/prikkeregler/" style="color: #4b5563; text-decoration: underline;">arrangementreglene</a>.</p>
  </td>
</tr>
