{{> event-image }}
<tr>
  <td class="text-primary" style="color: #000000; font-size: 16px; line-height: 25px; overflow-wrap: anywhere; word-wrap: break-word;">
    <p style="margin: 0 0 16px;">Hei!</p>
    <p style="margin: 0;">Dette er en melding fra arrangørene av {{ eventName }}, som du er påmeldt hos Linjeforeningen Online.</p>
  </td>
</tr>
<tr>
  <td style="padding: 24px 0 0;">
    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="table-layout: fixed;">
      <tbody>
        <tr>
          <td class="card-message" bgcolor="#f3f4f6" style="padding: 16px; background-color: #f3f4f6; border-radius: 8px;">
    <p class="text-primary" style="margin: 0; color: #000000; font-size: 16px; line-height: 25px; white-space: pre-wrap; overflow-wrap: anywhere; word-wrap: break-word;">{{ message }}</p>
          </td>
        </tr>
      </tbody>
    </table>
  </td>
</tr>
<tr>
  <td style="padding: 24px 0 0;">
    <table border="0" cellpadding="0" cellspacing="0" role="presentation">
      <tbody>
        <tr>
          {{# buttons.event }}
          {{> primary-button }}
          {{/ buttons.event }}
        </tr>
      </tbody>
    </table>
  </td>
</tr>
