<style>
  @font-face {
    font-family: Inter;
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url("https://cdn.jsdelivr.net/npm/@fontsource-variable/inter@5.2.8/files/inter-latin-wght-normal.woff2") format("woff2");
    mso-font-alt: Arial;
    mso-generic-font-family: swiss;
  }

  :root {
    color-scheme: light dark;
    supported-color-schemes: light dark;
  }

  @media (prefers-color-scheme: dark) {
    .email-bg {
      background-color: #1c1917 !important;
    }

    .event-image {
      background-color: #292524 !important;
    }

    .text-primary {
