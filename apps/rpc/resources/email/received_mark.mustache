<tr>
  <td class="text-primary" style="color: #000000; font-size: 16px; line-height: 25px; overflow-wrap: anywhere; word-wrap: break-word;">
    <p style="margin: 0 0 16px;">Hei!</p>
    <p style="margin: 0;">Du har fått {{ markCountLabel }} for: {{ title }}.</p>
  </td>
</tr>
{{# details }}
<tr>
  <td class="text-primary" style="padding: 24px 0 0; color: #000000; font-size: 16px; line-height: 25px; overflow-wrap: anywhere; word-wrap: break-word;">
    <p style="margin: 0;"><span style="white-space: pre-wrap;">{{ details }}</span></p>
  </td>
</tr>
{{/ details }}
<tr>
  <td class="text-primary" style="padding: 24px 0 0; color: #000000; font-size: 16px; line-height: 25px; overflow-wrap: anywhere; word-wrap: break-word;">
    <p style="margin: 0;">Du har fått {{ markCountLabel }} som varer frem til {{ endsAt }}.</p>
  </td>
</tr>
<tr>
  <td style="padding: 24px 0 0; font-size: 0;">
    <!--[if mso]><table border="0" cellpadding="0" cellspacing="0" role="presentation"><tr><td style="padding-right: 8px;"><![endif]-->
    <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="display: inline-table; vertical-align: top; margin: 0 8px 8px 0;">
      <tbody>
        <tr>
          {{# buttons.rules }}
          {{> primary-button }}
          {{/ buttons.rules }}
        </tr>
      </tbody>
    </table>
    <!--[if mso]></td><td><![endif]-->
    <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="display: inline-table; vertical-align: top; margin: 0 8px 8px 0;">
      <tbody>
        <tr>
          {{# buttons.profile }}
          {{> secondary-button }}
          {{/ buttons.profile }}
        </tr>
      </tbody>
    </table>
    <!--[if mso]></td></tr></table><![endif]-->
  </td>
</tr>
