<tr>
  <td class="text-primary" style="color: #000000; font-size: 16px; line-height: 25px; overflow-wrap: anywhere; word-wrap: break-word;">
    <p style="margin: 0 0 16px;">Hei!</p>
    <p style="margin: 0;">Du har fått en varsling fra {{ senderName }}.</p>
  </td>
</tr>
<tr>
  <td style="padding: 24px 0 0;">
    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="table-layout: fixed;">
      <tbody>
        <tr>
          <td class="card-message" bgcolor="#f3f4f6" style="padding: 16px; background-color: #f3f4f6; border-radius: 8px;">
            <div class="text-primary" style="color: #000000; font-size: 16px; line-height: 25px; overflow-wrap: anywhere; word-wrap: break-word;">{{{ richText.message }}}</div>
          </td>
        </tr>
      </tbody>
    </table>
  </td>
</tr>
<tr>
  <td style="padding: 24px 0 0; font-size: 0;">
    {{# buttons.link }}
    <!--[if mso]><table border="0" cellpadding="0" cellspacing="0" role="presentation"><tr><td style="padding-right: 8px;"><![endif]-->
    <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="display: inline-table; vertical-align: top; margin: 0 8px 8px 0;">
      <tbody>
        <tr>
          {{> primary-button }}
        </tr>
      </tbody>
    </table>
    <!--[if mso]></td><td><![endif]-->
    {{/ buttons.link }}
    <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="display: inline-table; vertical-align: top; margin: 0 8px 8px 0;">
      <tbody>
        <tr>
          {{# buttons.notification }}
          {{> secondary-button }}
          {{/ buttons.notification }}
        </tr>
      </tbody>
    </table>
    {{# buttons.link }}
    <!--[if mso]></td></tr></table><![endif]-->
    {{/ buttons.link }}
  </td>
</tr>
