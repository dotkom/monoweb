<tr>
  <td class="text-primary" style="color: #000000; font-size: 16px; line-height: 25px; overflow-wrap: anywhere; word-wrap: break-word;">
    <p style="margin: 0 0 16px;">Hei {{ contactName }}!</p>
    <p style="margin: 0;">Vi har mottatt interessen du sendte inn på vegne av {{ companyName }}. Her er en kopi av skjemaet ditt.</p>
  </td>
</tr>
<tr>
