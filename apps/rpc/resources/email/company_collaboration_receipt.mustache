      <li{{^requestsCourseEvent}} class="text-muted"{{/requestsCourseEvent}} style="margin: 0 0 4px; padding-left: 24px; text-indent: -24px;{{^requestsCourseEvent}} color: #6b7280;{{/requestsCourseEvent}}">{{#requestsCourseEvent}}<span class="interest-yes" role="img" aria-label="Ja" style="display: inline-block; width: 16px; padding-right: 8px; color: #15803d; font-family: Arial, sans-serif; font-size: 18px; line-height: 25px; text-indent: 0; text-align: center;">&#10003;</span>{{/requestsCourseEvent}}{{^requestsCourseEvent}}<span class="interest-no" role="img" aria-label="Nei" style="display: inline-block; width: 16px; padding-right: 8px; color: #6b7280; font-family: Arial, sans-serif; font-size: 18px; line-height: 25px; text-indent: 0; text-align: center;">&#8722;</span>{{/requestsCourseEvent}}Kurs</li>
      <li{{^requestsTwoInOneDeal}} class="text-muted"{{/requestsTwoInOneDeal}} style="margin: 0 0 4px; padding-left: 24px; text-indent: -24px;{{^requestsTwoInOneDeal}} color: #6b7280;{{/requestsTwoInOneDeal}}">{{#requestsTwoInOneDeal}}<span class="interest-yes" role="img" aria-label="Ja" style="display: inline-block; width: 16px; padding-right: 8px; color: #15803d; font-family: Arial, sans-serif; font-size: 18px; line-height: 25px; text-indent: 0; text-align: center;">&#10003;</span>{{/requestsTwoInOneDeal}}{{^requestsTwoInOneDeal}}<span class="interest-no" role="img" aria-label="Nei" style="display: inline-block; width: 16px; padding-right: 8px; color: #6b7280; font-family: Arial, sans-serif; font-size: 18px; line-height: 25px; text-indent: 0; text-align: center;">&#8722;</span>{{/requestsTwoInOneDeal}}Bedriftspresentasjon + kurs (pakkedeal)</li>
