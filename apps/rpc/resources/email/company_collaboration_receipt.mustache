      <li{{^requestsCollaborationEvent}} class="text-muted"{{/requestsCollaborationEvent}} style="margin: 0 0 4px; padding-left: 24px; text-indent: -24px;{{^requestsCollaborationEvent}} color: #6b7280;{{/requestsCollaborationEvent}}">{{#requestsCollaborationEvent}}<span class="interest-yes" role="img" aria-label="Ja" style="display: inline-block; width: 16px; padding-right: 8px; color: #15803d; font-family: Arial, sans-serif; font-size: 18px; line-height: 25px; text-indent: 0; text-align: center;">&#10003;</span>{{/requestsCollaborationEvent}}{{^requestsCollaborationEvent}}<span class="interest-no" role="img" aria-label="Nei" style="display: inline-block; width: 16px; padding-right: 8px; color: #6b7280; font-family: Arial, sans-serif; font-size: 18px; line-height: 25px; text-indent: 0; text-align: center;">&#8722;</span>{{/requestsCollaborationEvent}}Samarbeidsarrangement med andre linjeforeninger</li>
      <li{{^requestsFemalesInTechEvent}} class="text-muted"{{/requestsFemalesInTechEvent}} style="margin: 0; padding-left: 24px; text-indent: -24px;{{^requestsFemalesInTechEvent}} color: #6b7280;{{/requestsFemalesInTechEvent}}">{{#requestsFemalesInTechEvent}}<span class="interest-yes" role="img" aria-label="Ja" style="display: inline-block; width: 16px; padding-right: 8px; color: #15803d; font-family: Arial, sans-serif; font-size: 18px; line-height: 25px; text-indent: 0; text-align: center;">&#10003;</span>{{/requestsFemalesInTechEvent}}{{^requestsFemalesInTechEvent}}<span class="interest-no" role="img" aria-label="Nei" style="display: inline-block; width: 16px; padding-right: 8px; color: #6b7280; font-family: Arial, sans-serif; font-size: 18px; line-height: 25px; text-indent: 0; text-align: center;">&#8722;</span>{{/requestsFemalesInTechEvent}}Samarbeidsarrangement med FeminIT</li>
    </ul>
  </td>
</tr>
{{# comment }}
<tr>
  <td style="padding: 24px 0 0;">
