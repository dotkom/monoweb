        <tr>
          <td class="card-message" bgcolor="#f3f4f6" style="padding: 16px; background-color: #f3f4f6; border-radius: 8px;">
            <div class="text-primary" style="color: #000000; font-size: 16px; line-height: 25px; overflow-wrap: anywhere; word-wrap: break-word;">{{{ richText.comment }}}</div>
          </td>
